<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:CommitDesk.Converters"
             x:Class="CommitDesk.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmpty" />
            <conv:InvertBoolConverter x:Key="InvertBool" />
            <conv:DiffLineBackgroundConverter x:Key="DiffLineBackground" />
            <conv:DiffGutterConverter x:Key="DiffGutter" />
            <conv:DiffLineTextColorConverter x:Key="DiffLineTextColor" />
            <conv:FileChangeKindColorConverter x:Key="FileChangeKindColor" />
            <conv:RelativeTimeConverter x:Key="RelativeTime" />
            <conv:PipelineStatusColorConverter x:Key="PipelineStatusColor" />
            <conv:ConflictGlyphConverter x:Key="ConflictGlyph" />
            <conv:ConflictColorConverter x:Key="ConflictColor" />
            <conv:PipelineStatusGlyphConverter x:Key="PipelineStatusGlyph" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
