<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CommitDesk.Views.TextPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource PaneLight}, Dark={StaticResource PaneDark}}">
    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="10">
        <Label x:Name="TitleLabel" Style="{StaticResource DialogTitle}" />
        <Editor x:Name="Body" Grid.Row="1" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12" />
        <Button Grid.Row="2" Text="Close" HorizontalOptions="End" Clicked="OnClose" />
    </Grid>
</ContentPage>
