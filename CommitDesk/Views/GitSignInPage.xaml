<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CommitDesk.ViewModels"
             x:Class="CommitDesk.Views.GitSignInPage"
             x:DataType="vm:GitSignInViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PaneLight}, Dark={StaticResource PaneDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="10" MaximumWidthRequest="560" VerticalOptions="Center">
            <Label Text="{Binding Heading}" Style="{StaticResource DialogTitle}" />
            <Label Text="{Binding Message}" />
            <Label Text="{Binding GitError}" Style="{StaticResource SecondaryText}" FontFamily="{StaticResource MonoFont}"
                   MaxLines="4" LineBreakMode="TailTruncation" />

            <!-- Asked only when the app couldn't recognise the server; otherwise just stated. -->
            <VerticalStackLayout Spacing="4" Margin="0,8,0,0" IsVisible="{Binding CanChooseServerType}">
                <Label Text="Server type" Style="{StaticResource SecondaryText}" />
                <Picker ItemsSource="{Binding ServerTypeNames}" SelectedIndex="{Binding ServerTypeIndex}" />
                <Label Text="{Binding ServerTypeHelp}" Style="{StaticResource SecondaryText}" />
            </VerticalStackLayout>
            <Label Text="{Binding ServerTypeText}" IsVisible="{Binding ShowsServerType}" Style="{StaticResource SecondaryText}" />

            <Label Text="Username" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
            <Entry Text="{Binding UserName}" Placeholder="Username" />

            <Label Text="Password or access token" Style="{StaticResource SecondaryText}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="SecretEntry" Text="{Binding Secret}" IsPassword="True" Placeholder="Password or token"
                       ReturnCommand="{Binding SignInCommand}" />
                <Button Grid.Column="1" Text="Create token…" Command="{Binding CreateTokenCommand}" IsVisible="{Binding CanCreateToken}"
                        Style="{StaticResource SecondaryButton}" />
            </Grid>
            <Label Text="{Binding SecretHelp}" Style="{StaticResource SecondaryText}" />

            <VerticalStackLayout Spacing="0" Margin="0,6,0,0" IsVisible="{Binding HasRepositoryName}">
                <Label Text="Use this sign-in for" Style="{StaticResource SecondaryText}" />
                <!-- Formatted from Host and RepositoryName here: bound to computed text properties (and as RadioButton
                     Content), these came up empty on Windows. -->
                <Grid ColumnDefinitions="Auto,*">
                    <RadioButton IsChecked="{Binding ForAllRepositories}" GroupName="scope" />
                    <Label Grid.Column="1" Text="{Binding Host, StringFormat='All repositories on {0}'}" VerticalOptions="Center">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ChooseAllRepositoriesCommand}" /></Label.GestureRecognizers>
                    </Label>
                </Grid>
                <Grid ColumnDefinitions="Auto,*">
                    <RadioButton IsChecked="{Binding ForThisRepository}" GroupName="scope" />
                    <Label Grid.Column="1" Text="{Binding RepositoryName, StringFormat='Only this repository ({0})'}" VerticalOptions="Center">
                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ChooseThisRepositoryCommand}" /></Label.GestureRecognizers>
                    </Label>
                </Grid>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="Auto,*">
                <CheckBox IsChecked="{Binding Remember}" />
                <Label Grid.Column="1" Text="Remember on this computer (stored in secure storage)" VerticalOptions="Center" />
            </Grid>
            <Label Text="{Binding ApiNote}" IsVisible="{Binding ShowApiNote}" Style="{StaticResource SecondaryText}" />

            <Label Text="{Binding Error}" TextColor="{StaticResource KindDeleted}"
                   IsVisible="{Binding Error, Converter={StaticResource IsNotNullOrEmpty}}" />

            <HorizontalStackLayout HorizontalOptions="End" Spacing="8" Margin="0,8,0,0">
                <Button Text="Cancel" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Text="Sign in" Command="{Binding SignInCommand}" FontAttributes="Bold" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
