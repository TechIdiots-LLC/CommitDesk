<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:CommitDesk.Services"
             xmlns:views="clr-namespace:CommitDesk.Views"
             x:Class="CommitDesk.Views.PickerDropdown">

    <!-- A click anywhere outside the panel closes it, like a menu. -->
    <Grid>
        <Grid BackgroundColor="#01000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOutsideTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <Border x:Name="Panel" HorizontalOptions="Start" VerticalOptions="Fill" Padding="0" StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource PaneLight}, Dark={StaticResource PaneDark}}">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.35" Radius="12" Offset="0,4" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,*">
                <!-- Branches | Pull requests (or Merge requests), only when there is a second tab -->
                <Grid x:Name="TabBar" ColumnDefinitions="*,*" IsVisible="False">
                    <Grid>
                        <Button x:Name="FirstTabLabel" Text="Branches" Style="{StaticResource TabButton}" Clicked="OnFirstTabTapped" />
                        <BoxView x:Name="FirstTabLine" HeightRequest="3" VerticalOptions="End" Color="{StaticResource GitLabOrange}" />
                    </Grid>
                    <Grid Grid.Column="1">
                        <Button x:Name="SecondTabLabel" Style="{StaticResource TabButton}" Clicked="OnSecondTabTapped" />
                        <BoxView x:Name="SecondTabLine" HeightRequest="3" VerticalOptions="End" Color="Transparent" />
                    </Grid>
                </Grid>

                <Grid x:Name="Header" Grid.Row="1" ColumnDefinitions="*" ColumnSpacing="8" Padding="10">
                    <SearchBar x:Name="Search" Placeholder="Filter" TextChanged="OnSearchChanged"
                               SearchButtonPressed="OnSearchSubmitted" />
                </Grid>

                <CollectionView x:Name="List" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnSelected">
                    <CollectionView.EmptyView>
                        <Label x:Name="EmptyLabel" Text="Nothing to show" Margin="14,12,28,12" LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </CollectionView.EmptyView>
                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate x:DataType="views:PickerGroup">
                            <Label Text="{Binding Name}" FontAttributes="Bold" Padding="10,10,10,4" />
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:PickerItem">
                            <Grid ColumnDefinitions="*,Auto" Padding="14,6" ColumnSpacing="8">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="{Binding Title}" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Subtitle}" FontSize="12" LineBreakMode="HeadTruncation"
                                           IsVisible="{Binding Subtitle, Converter={StaticResource IsNotNullOrEmpty}}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding Badge}" FontSize="12" VerticalOptions="Center"
                                       IsVisible="{Binding HasPlainBadge}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <!-- CI status of a merge/pull request -->
                                <Label Grid.Column="1" Text="{Binding Badge}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"
                                       IsVisible="{Binding HasColoredBadge}" TextColor="{Binding BadgeColor}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentView>
