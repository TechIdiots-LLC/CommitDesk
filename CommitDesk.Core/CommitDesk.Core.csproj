<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Pure .NET 10 class library — no platform suffix so it works as a dependency
      for both the MAUI head project (multi-targeted) and any unit test project.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- libgit2, for platforms without the git command line (Android). LibGit2Sharp.NativeBinaries has no Android build:
         the app carries its own (native/android, from build/build-libgit2-android.sh) for the same libgit2 commit. -->
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
  </ItemGroup>

</Project>
