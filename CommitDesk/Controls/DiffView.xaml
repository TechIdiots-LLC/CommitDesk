<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:git="clr-namespace:CommitDesk.Core.Git;assembly=CommitDesk.Core"
             xmlns:controls="clr-namespace:CommitDesk.Controls"
             x:Class="CommitDesk.Controls.DiffView"
             x:Name="Root">

    <Grid>
        <CollectionView x:Name="List"
                        ItemsSource="{Binding Lines, Source={x:Reference Root}, x:DataType=controls:DiffView}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="git:DiffLine">
                    <Grid ColumnDefinitions="5,48,48,*"
                          BackgroundColor="{Binding Kind, Converter={StaticResource DiffLineBackground}}">

                        <!-- Gutter: solid when the line is included in the commit -->
                        <BoxView Grid.Column="0">
                            <BoxView.Color>
                                <MultiBinding Converter="{StaticResource DiffGutter}">
                                    <Binding Path="Kind" />
                                    <Binding Path="IsSelected" />
                                    <Binding Path="IsSelectable" />
                                </MultiBinding>
                            </BoxView.Color>
                        </BoxView>

                        <Label Grid.Column="1" Text="{Binding OldLineNumber}" Style="{StaticResource DiffLineNumber}" />
                        <Label Grid.Column="2" Text="{Binding NewLineNumber}" Style="{StaticResource DiffLineNumber}" />

                        <Label Grid.Column="3"
                               Text="{Binding Text}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="12"
                               Padding="8,1"
                               LineBreakMode="CharacterWrap"
                               TextColor="{Binding Kind, Converter={StaticResource DiffLineTextColor}}" />

                        <!-- Clicking the gutter / line numbers toggles the line (or the whole hunk on its header) -->
                        <BoxView Grid.Column="0" Grid.ColumnSpan="3" Color="Transparent">
                            <BoxView.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding ToggleCommand, Source={x:Reference Root}, x:DataType=controls:DiffView}"
                                    CommandParameter="{Binding .}" />
                            </BoxView.GestureRecognizers>
                        </BoxView>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Text="{Binding Message, Source={x:Reference Root}, x:DataType=controls:DiffView}"
               IsVisible="{Binding Message, Source={x:Reference Root}, x:DataType=controls:DiffView, Converter={StaticResource IsNotNullOrEmpty}}"
               HorizontalOptions="Center" VerticalOptions="Center" Margin="24"
               Style="{StaticResource SecondaryText}" FontSize="14" />
    </Grid>
</ContentView>
