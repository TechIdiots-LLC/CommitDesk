<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CommitDesk.ViewModels"
             xmlns:hosting="clr-namespace:CommitDesk.Core.Hosting;assembly=CommitDesk.Core"
             x:Class="CommitDesk.Views.ClonePage"
             x:DataType="vm:CloneViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PaneLight}, Dark={StaticResource PaneDark}}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" RowSpacing="8" Padding="16" MaximumWidthRequest="720">
        <Label Text="Clone a repository" Style="{StaticResource DialogTitle}" />
        <Label Grid.Row="1" Text="{Binding InstanceText}" Style="{StaticResource SecondaryText}" />
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding CanBrowse}">
            <Picker ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" ItemDisplayBinding="{Binding Title, x:DataType=vm:CloneSource}"
                    IsVisible="{Binding HasSeveralSources}" MinimumWidthRequest="220" />
            <SearchBar Grid.Column="1" Text="{Binding Search}" Placeholder="Filter your projects" />
        </Grid>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Projects}" SelectionMode="Single" SelectedItem="{Binding SelectedProject}"
                        IsVisible="{Binding CanBrowse}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="hosting:HostedProject">
                    <VerticalStackLayout Padding="10,6">
                        <Label Text="{Binding FullName}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Description}" Style="{StaticResource SecondaryText}" LineBreakMode="TailTruncation"
                               IsVisible="{Binding Description, Converter={StaticResource IsNotNullOrEmpty}}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="4" Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Repository URL" Style="{StaticResource SecondaryText}" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1">
                    <CheckBox IsChecked="{Binding UseSsh}" />
                    <Label Text="SSH" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
            <Entry Text="{Binding Url}" Placeholder="https://gitlab.example.com/group/project.git" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="5" Spacing="4">
            <Label Text="Local path" Style="{StaticResource SecondaryText}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Text="{Binding LocalPath}" />
                <Button Grid.Column="1" Text="Choose…" Command="{Binding BrowseCommand}" Style="{StaticResource SecondaryButton}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
                <CheckBox IsChecked="{Binding RecurseSubmodules}" />
                <Label Grid.Column="1" Text="Include submodules (the default is set in Options › Repositories)" VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <Label Grid.Row="6" Text="{Binding Error}" TextColor="{StaticResource KindDeleted}"
               IsVisible="{Binding Error, Converter={StaticResource IsNotNullOrEmpty}}" />

        <Grid Grid.Row="7" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <!-- git's own progress: "Receiving objects: 45% (450/1000), 1.20 MiB | 2.00 MiB/s" -->
            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsBusy}" VerticalOptions="Center">
                <Label Text="{Binding CloneStatus}" FontSize="12" LineBreakMode="TailTruncation"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                <ProgressBar Progress="{Binding CloneProgress}" ProgressColor="{StaticResource Primary}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Cancel" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Grid.Column="2" Text="Clone" Command="{Binding CloneCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
        </Grid>
    </Grid>
</ContentPage>
