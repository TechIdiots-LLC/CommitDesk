<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to a new device (Android 12+). Saved sign-ins are encrypted with a key that stays in this
     device's keystore, so a restored copy couldn't be read; settings and accounts are added again on the new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
