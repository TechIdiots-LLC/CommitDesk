<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CommitDesk.ViewModels"
             xmlns:controls="clr-namespace:CommitDesk.Controls"
             x:Class="CommitDesk.Views.ConflictsPage"
             x:DataType="vm:ConflictsViewModel"
             x:Name="Root"
             BackgroundColor="{AppThemeBinding Light={StaticResource PaneLight}, Dark={StaticResource PaneDark}}">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="24" RowSpacing="12" MaximumWidthRequest="760">
        <Label Text="{Binding Heading}" Style="{StaticResource DialogTitle}" />
        <Label Grid.Row="1" Text="{Binding Summary}" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Files}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ConflictFileViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Padding="4,10">
                        <Label Text="{Binding IsResolved, Converter={StaticResource ConflictGlyph}}" FontSize="16" FontAttributes="Bold"
                               VerticalOptions="Center" WidthRequest="18"
                               TextColor="{Binding IsResolved, Converter={StaticResource ConflictColor}}" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <controls:PathLabel Directory="{Binding Directory}" FileName="{Binding FileName}" FontSize="14" />
                            <Label Text="{Binding StatusText}" FontSize="12"
                                   TextColor="{Binding IsResolved, Converter={StaticResource ConflictColor}}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="Open in editor" Style="{StaticResource SecondaryButton}" Padding="10,2"
                                IsVisible="{Binding CanEdit}" VerticalOptions="Center"
                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenInEditorCommand, x:DataType=ContentPage}"
                                CommandParameter="{Binding .}" />
                        <Button Grid.Column="3" Text="Use a version ▾" Style="{StaticResource SecondaryButton}" Padding="10,2"
                                IsVisible="{Binding CanChooseSide}" VerticalOptions="Center"
                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.ChooseSideCommand, x:DataType=ContentPage}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="3" Text="{Binding Error}" TextColor="{StaticResource KindDeleted}"
               IsVisible="{Binding Error, Converter={StaticResource IsNotNullOrEmpty}}" />

        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <Button Text="{Binding AbortText}" Command="{Binding AbortCommand}" Style="{StaticResource SecondaryButton}"
                    IsVisible="{Binding HasOperation}" />
            <Button Grid.Column="2" Text="Close" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButton}" />
            <Button Grid.Column="3" Text="{Binding ContinueText}" Command="{Binding ContinueCommand}" FontAttributes="Bold"
                    IsVisible="{Binding HasOperation}" IsEnabled="{Binding CanContinue}" />
        </Grid>
    </Grid>
</ContentPage>
